generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                 String                         @id
  name                               String
  email                              String
  emailVerified                      Boolean                        @default(false)
  image                              String?
  createdAt                          DateTime                       @default(now())
  updatedAt                          DateTime                       @updatedAt
  role                               String?
  mustChangePassword                 Boolean                        @default(false)
  banned                             Boolean?                       @default(false)
  banReason                          String?
  banExpires                         DateTime?
  sessions                           Session[]
  accounts                           Account[]
  auditLogs                          AuditLog[]
  createdCases                       CaseFile[]                     @relation("CaseFileCreatedBy")
  updatedCases                       CaseFile[]                     @relation("CaseFileUpdatedBy")
  archivedCases                      CaseFile[]                     @relation("CaseFileArchivedBy")
  caseChanges                        CaseFileChange[]
  caseNotes                          CaseNote[]
  caseDocuments                      CaseDocument[]
  caseReminders                      CaseReminder[]
  createdCaseTransactions            CaseTransaction[]              @relation("CaseTransactionCreatedBy")
  deletedCaseTransactions            CaseTransaction[]              @relation("CaseTransactionDeletedBy")
  createdInsuranceCases              InsuranceArbitrationCase[]     @relation("InsuranceArbitrationCaseCreatedBy")
  updatedInsuranceCases              InsuranceArbitrationCase[]     @relation("InsuranceArbitrationCaseUpdatedBy")
  insuranceDocuments                 InsuranceArbitrationDocument[]
  createdGeneralCases                GeneralLegalCase[]             @relation("GeneralLegalCaseCreatedBy")
  updatedGeneralCases                GeneralLegalCase[]             @relation("GeneralLegalCaseUpdatedBy")
  archivedGeneralCases               GeneralLegalCase[]             @relation("GeneralLegalCaseArchivedBy")
  responsibleGeneralCases            GeneralLegalCase[]             @relation("GeneralLegalCaseResponsibleUser")
  staffedGeneralCases                GeneralLegalCase[]             @relation("GeneralLegalCaseFileStaff")
  representedGeneralParties          GeneralCaseParty[]             @relation("GeneralCasePartyRepresentative")
  createdGeneralCaseFinancialEntries GeneralCaseFinancialEntry[]    @relation("GeneralCaseFinancialEntryCreatedBy")
  deletedGeneralCaseFinancialEntries GeneralCaseFinancialEntry[]    @relation("GeneralCaseFinancialEntryDeletedBy")
  reminderDeliveries                 ReminderDelivery[]

  @@unique([email])
  @@index([role])
  @@index([banned])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model EmailRateLimit {
  key         String @id
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("email_rate_limit")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  event         String
  targetType    String?
  targetId      String?
  context       Json?
  ipAddressHash String?
  createdAt     DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

enum CaseFileStatus {
  OPEN
  ENFORCEMENT
  INSTALLMENT
  PENDING
  CLOSED
}

enum DebtorType {
  INSURANCE_COMPANY
  INDIVIDUAL
  COMPANY
}

enum JudgmentStatus {
  WITHOUT_JUDGMENT
  WITH_JUDGMENT
}

enum CaseTransactionType {
  INCOME
  EXPENSE
}

enum CaseTransactionCategory {
  PRINCIPAL
  PRE_FOLLOW_UP_INTEREST
  POST_FOLLOW_UP_INTEREST
  ATTORNEY_FEE
  EXPENSE
  LITIGATION_EXPENSE
  PRISON_FEE
  COLLECTION_FEE
  OTHER
  EXPENSE_REFUND
  PENALTY_COMPENSATION
  OTHER_INCOME
  FEE
  NOTIFICATION
  EXPERT_FEE
  ATTORNEY_PAYMENT
  OTHER_EXPENSE
}

enum CaseFileChangeType {
  CREATED
  UPDATED
  STATUS_CHANGED
}

enum ReminderStatus {
  PENDING
  SENT
  PARTIALLY_SENT
  FAILED
  CANCELLED
}

model CaseFile {
  id                    String            @id @default(cuid())
  referenceNumber       String            @unique
  licenseHolder         String
  vehiclePlate          String
  accidentDate          DateTime          @db.Date
  debtorType            DebtorType
  debtorName            String?
  damageAmount          Decimal           @default(0) @db.Decimal(18, 2)
  depreciationAmount    Decimal           @default(0) @db.Decimal(18, 2)
  profitLossAmount      Decimal           @default(0) @db.Decimal(18, 2)
  hasDamageClaim        Boolean           @default(false)
  hasDepreciationClaim  Boolean           @default(false)
  hasProfitLossClaim    Boolean           @default(false)
  profitLossDays        Int?
  dailyRentalAmount     Decimal?          @db.Decimal(18, 2)
  judgmentStatus        JudgmentStatus    @default(WITHOUT_JUDGMENT)
  discountAmount        Decimal           @default(0) @db.Decimal(18, 2)
  enforcementOffice     String?
  enforcementFileNumber String?
  vehicleLien           Boolean           @default(false)
  bankLien              Boolean           @default(false)
  titleDeedLien         Boolean           @default(false)
  salaryLien            Boolean           @default(false)
  installmentCount      Int?
  status                CaseFileStatus    @default(OPEN)
  version               Int               @default(1)
  createdById           String
  updatedById           String
  archivedById          String?
  archivedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  createdBy             User              @relation("CaseFileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User              @relation("CaseFileUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy            User?             @relation("CaseFileArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  changes               CaseFileChange[]
  notes                 CaseNote[]
  documents             CaseDocument[]
  reminders             CaseReminder[]
  transactions          CaseTransaction[]

  @@unique([enforcementOffice, enforcementFileNumber])
  @@index([status])
  @@index([vehiclePlate])
  @@index([accidentDate])
  @@index([debtorName])
  @@index([createdAt])
  @@index([archivedAt])
  @@map("case_file")
}

model CaseFileChange {
  id              String             @id @default(cuid())
  caseFileId      String
  changedById     String
  changeType      CaseFileChangeType
  previousVersion Int?
  newVersion      Int
  changedFields   Json?
  snapshot        Json
  createdAt       DateTime           @default(now())
  caseFile        CaseFile           @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  changedBy       User               @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([caseFileId, createdAt])
  @@index([changedById, createdAt])
  @@map("case_file_change")
}

model CaseNote {
  id         String   @id @default(cuid())
  caseFileId String
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  caseFile   CaseFile @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseFileId, createdAt])
  @@index([authorId, createdAt])
  @@map("case_note")
}

model CaseDocument {
  id            String           @id @default(cuid())
  caseFileId    String
  uploadedById  String
  originalName  String           @db.VarChar(255)
  storageKey    String           @unique
  mimeType      String           @db.VarChar(100)
  sizeBytes     Int
  sha256        String           @db.Char(64)
  transactionId String?
  createdAt     DateTime         @default(now())
  caseFile      CaseFile         @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  uploadedBy    User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  transaction   CaseTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([caseFileId, createdAt])
  @@index([uploadedById, createdAt])
  @@index([transactionId])
  @@map("case_document")
}

enum InsuranceCaseType {
  DEPRECIATION
  DEPRECIATION_DIFFERENCE
  DAMAGE_DIFFERENCE
  ZERO_DAMAGE
}

enum InsuranceArbitrationStatus {
  INSURANCE_APPLICATION
  SETTLEMENT_REVIEW
  ARBITRATION_APPLICATION
  ARBITRATION
  EXPERT_REVIEW
  PAYMENT_PENDING
  INSURANCE_PAYMENT_RECEIVED
  ENFORCEMENT
  LITIGATION
  COMPLETED
  CLOSED
}

enum InsurancePaymentType {
  OUTGOING_PAYMENT
  INSURANCE_INCOME
  ARBITRATION_INCOME
  ENFORCEMENT_INCOME
}

model InsuranceArbitrationCase {
  id                         String                         @id @default(cuid())
  referenceNumber            String                         @unique
  arbitrationApplicationNo   String?                        @unique
  opposingInsuranceCompany   String
  opposingPolicyNumber       String?
  policyExpiryDate           DateTime?                      @db.Date
  opposingVehicleOwner       String?
  opposingIdentityNumber     String?
  vehicleOwner               String
  identityNumber             String?
  vehiclePlate               String
  accidentDate               DateTime                       @db.Date
  postalDeliveryDate         DateTime?                      @db.Date
  caseTypes                  InsuranceCaseType[]            @map("caseType")
  insuranceApplicationDate   DateTime?                      @db.Date
  insuranceSettlementOffer   Decimal                        @default(0) @db.Decimal(18, 2)
  arbitrationApplicationDate DateTime?                      @db.Date
  hasArbitration             Boolean                        @default(false)
  arbitrationCaseNumber      String?
  status                     InsuranceArbitrationStatus     @default(INSURANCE_APPLICATION)
  postageExpense             Decimal                        @default(0) @db.Decimal(18, 2)
  enforcementExpense         Decimal                        @default(0) @db.Decimal(18, 2)
  arbitrationApplicationFee  Decimal                        @default(0) @db.Decimal(18, 2)
  expertFee                  Decimal                        @default(0) @db.Decimal(18, 2)
  postalAmount               Decimal                        @default(0) @db.Decimal(18, 2)
  actualDepreciationAmount   Decimal                        @default(0) @db.Decimal(18, 2)
  description                String?
  version                    Int                            @default(1)
  createdById                String
  updatedById                String
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  createdBy                  User                           @relation("InsuranceArbitrationCaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                  User                           @relation("InsuranceArbitrationCaseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  documents                  InsuranceArbitrationDocument[]
  payments                   InsuranceArbitrationPayment[]

  @@index([vehiclePlate])
  @@index([opposingInsuranceCompany])
  @@index([accidentDate])
  @@index([status])
  @@index([updatedAt])
  @@map("insurance_arbitration_case")
}

model InsuranceArbitrationPayment {
  id           String                   @id @default(cuid())
  caseId       String
  type         InsurancePaymentType
  paymentDate  DateTime                 @db.Date
  amount       Decimal                  @db.Decimal(18, 2)
  commission   Decimal                  @default(0) @db.Decimal(18, 2)
  clientAmount Decimal                  @default(0) @db.Decimal(18, 2)
  description  String?                  @db.VarChar(500)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  case         InsuranceArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, paymentDate, createdAt])
  @@map("insurance_arbitration_payment")
}

model InsuranceArbitrationDocument {
  id           String                   @id @default(cuid())
  caseId       String
  uploadedById String
  originalName String                   @db.VarChar(255)
  storageKey   String                   @unique
  mimeType     String                   @db.VarChar(100)
  sizeBytes    Int
  sha256       String                   @db.Char(64)
  createdAt    DateTime                 @default(now())
  case         InsuranceArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy   User                     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([uploadedById, createdAt])
  @@map("insurance_arbitration_document")
}

enum GeneralCaseKind {
  GENERAL_LITIGATION
  MEDIATION
}

enum GeneralCaseStatus {
  DRAFT
  ACTIVE
  DECISION
  APPEAL
  COMPLETED
  CLOSED
}

enum GeneralCaseStage {
  CASE_OPENING
  NOTIFICATION
  RESPONSE_PETITION
  PRELIMINARY_REVIEW
  EXAMINATION
  EXPERT_REPORT
  HEARING
  DECISION
  APPEAL
  CASSATION
  FINALIZATION
  COLLECTION
  CLOSED
}

enum GeneralCaseConfidentiality {
  NORMAL
  RESTRICTED
}

enum GeneralPartyKind {
  INDIVIDUAL
  ORGANIZATION
}

enum GeneralPartyRole {
  PLAINTIFF
  DEFENDANT
  APPLICANT
  RESPONDENT
  INTERVENOR
  THIRD_PARTY
  RELATED_INSTITUTION
}

enum GeneralFinancialEntryType {
  EXPENSE
  COLLECTION
  PAYMENT
}

enum GeneralCollectionStatus {
  NOT_COLLECTED
  PARTIAL
  COLLECTED
}

enum GeneralPaymentPlan {
  CASH
  INSTALLMENT
}

model GeneralLegalCase {
  id                       String                      @id @default(cuid())
  referenceNumber          String                      @unique
  kind                     GeneralCaseKind             @default(GENERAL_LITIGATION)
  caseType                 String                      @db.VarChar(100)
  subject                  String                      @db.Text
  openingDate              DateTime                    @db.Date
  caseValue                Decimal                     @default(0) @db.Decimal(18, 2)
  claimAmount              Decimal                     @default(0) @db.Decimal(18, 2)
  amendmentAmount          Decimal                     @default(0) @db.Decimal(18, 2)
  interestRequested        Boolean                     @default(false)
  interestStartDate        DateTime?                   @db.Date
  expectedCollectionAmount Decimal                     @default(0) @db.Decimal(18, 2)
  opposingAttorneyFee      Decimal                     @default(0) @db.Decimal(18, 2)
  collectionStatus         GeneralCollectionStatus     @default(NOT_COLLECTED)
  paymentPlan              GeneralPaymentPlan          @default(CASH)
  installmentCount         Int?
  financeDescription       String?                     @db.Text
  uyapMainNumber           String?                     @db.VarChar(80)
  uyapDecisionNumber       String?                     @db.VarChar(80)
  courthouse               String?                     @db.VarChar(150)
  courtType                String?                     @db.VarChar(100)
  court                    String?                     @db.VarChar(150)
  status                   GeneralCaseStatus           @default(ACTIVE)
  stage                    GeneralCaseStage            @default(CASE_OPENING)
  procedure                String?                     @db.VarChar(100)
  urgent                   Boolean                     @default(false)
  confidentiality          GeneralCaseConfidentiality  @default(NORMAL)
  estimatedCompletionDate  DateTime?                   @db.Date
  trackingGroup            String?                     @db.VarChar(100)
  tags                     String[]                    @default([])
  office                   String?                     @db.VarChar(100)
  description              String?                     @db.Text
  responsibleUserId        String
  fileStaffUserId          String?
  version                  Int                         @default(1)
  createdById              String
  updatedById              String
  archivedById             String?
  archivedAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  responsibleUser          User                        @relation("GeneralLegalCaseResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  fileStaffUser            User?                       @relation("GeneralLegalCaseFileStaff", fields: [fileStaffUserId], references: [id], onDelete: SetNull)
  createdBy                User                        @relation("GeneralLegalCaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                User                        @relation("GeneralLegalCaseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy               User?                       @relation("GeneralLegalCaseArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  parties                  GeneralCaseParty[]
  financialEntries         GeneralCaseFinancialEntry[]

  @@index([kind, status])
  @@index([stage])
  @@index([caseType])
  @@index([court])
  @@index([openingDate])
  @@index([responsibleUserId, status])
  @@index([updatedAt])
  @@index([archivedAt])
  @@map("general_legal_case")
}

model GeneralCaseParty {
  id                   String           @id @default(cuid())
  caseId               String
  role                 GeneralPartyRole
  kind                 GeneralPartyKind
  name                 String           @db.VarChar(200)
  identityOrTaxNumber  String?          @db.VarChar(20)
  phone                String?          @db.VarChar(30)
  email                String?          @db.VarChar(254)
  address              String?          @db.Text
  representativeUserId String?
  representativeName   String?          @db.VarChar(200)
  clientType           String?          @db.VarChar(100)
  description          String?          @db.VarChar(500)
  sortOrder            Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  case                 GeneralLegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  representativeUser   User?            @relation("GeneralCasePartyRepresentative", fields: [representativeUserId], references: [id], onDelete: SetNull)

  @@index([caseId, role, sortOrder])
  @@index([identityOrTaxNumber])
  @@index([name])
  @@index([representativeUserId])
  @@map("general_case_party")
}

model GeneralCaseFinancialEntry {
  id          String                    @id @default(cuid())
  caseId      String
  type        GeneralFinancialEntryType
  category    String                    @db.VarChar(100)
  entryDate   DateTime                  @db.Date
  amount      Decimal                   @db.Decimal(18, 2)
  description String                    @db.VarChar(500)
  createdById String
  deletedById String?
  createdAt   DateTime                  @default(now())
  deletedAt   DateTime?
  case        GeneralLegalCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User                      @relation("GeneralCaseFinancialEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy   User?                     @relation("GeneralCaseFinancialEntryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, entryDate, createdAt])
  @@index([caseId, deletedAt])
  @@index([createdById, createdAt])
  @@map("general_case_financial_entry")
}

model CaseTransaction {
  id              String                  @id @default(cuid())
  caseFileId      String
  type            CaseTransactionType
  category        CaseTransactionCategory
  transactionDate DateTime                @db.Date
  amount          Decimal                 @db.Decimal(18, 2)
  description     String                  @db.VarChar(500)
  createdById     String
  deletedById     String?
  createdAt       DateTime                @default(now())
  deletedAt       DateTime?
  caseFile        CaseFile                @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("CaseTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy       User?                   @relation("CaseTransactionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  documents       CaseDocument[]

  @@index([caseFileId, transactionDate, createdAt])
  @@index([caseFileId, deletedAt])
  @@index([createdById, createdAt])
  @@map("case_transaction")
}

model CaseReminder {
  id                 String             @id @default(cuid())
  caseFileId         String
  createdById        String
  title              String
  dueAt              DateTime
  sendEmail          Boolean            @default(true)
  sendSms            Boolean            @default(false)
  status             ReminderStatus     @default(PENDING)
  sentAt             DateTime?
  deliveryPreparedAt DateTime?
  nextPreparationAt  DateTime           @default(now())
  deliveries         ReminderDelivery[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  caseFile           CaseFile           @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  createdBy          User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, dueAt])
  @@index([caseFileId, dueAt])
  @@index([createdById, createdAt])
  @@index([deliveryPreparedAt, nextPreparationAt])
  @@map("case_reminder")
}

enum ReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  UNCERTAIN
  CANCELLED
}

model ReminderDelivery {
  id             String                 @id @default(cuid())
  reminderId     String
  recipientId    String
  recipientEmail String
  status         ReminderDeliveryStatus @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  startedAt      DateTime?
  sentAt         DateTime?
  failureCode    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  reminder       CaseReminder           @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  recipient      User                   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([reminderId, recipientId])
  @@index([status, nextAttemptAt])
  @@index([status, startedAt])
  @@map("reminder_delivery")
}
