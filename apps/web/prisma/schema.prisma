generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                   String                         @id
  name                                 String
  email                                String
  emailVerified                        Boolean                        @default(false)
  image                                String?
  createdAt                            DateTime                       @default(now())
  updatedAt                            DateTime                       @updatedAt
  role                                 String?
  mustChangePassword                   Boolean                        @default(false)
  banned                               Boolean?                       @default(false)
  banReason                            String?
  banExpires                           DateTime?
  deletionRequestedAt                  DateTime?
  deletionDueAt                        DateTime?
  deletedById                          String?
  sessions                             Session[]
  accounts                             Account[]
  auditLogs                            AuditLog[]
  createdCases                         CaseFile[]                     @relation("CaseFileCreatedBy")
  updatedCases                         CaseFile[]                     @relation("CaseFileUpdatedBy")
  archivedCases                        CaseFile[]                     @relation("CaseFileArchivedBy")
  archivedInsuranceCases               InsuranceArbitrationCase[]    @relation("InsuranceArbitrationCaseArchivedBy")
  caseChanges                          CaseFileChange[]
  caseNotes                            CaseNote[]                     @relation("CaseNoteAuthor")
  deletedCaseNotes                     CaseNote[]                     @relation("CaseNoteDeletedBy")
  caseDocuments                        CaseDocument[]                  @relation("CaseDocumentUploadedBy")
  deletedCaseDocuments                 CaseDocument[]                  @relation("CaseDocumentDeletedBy")
  caseReminders                        CaseReminder[]
  createdCaseTransactions              CaseTransaction[]              @relation("CaseTransactionCreatedBy")
  deletedCaseTransactions              CaseTransaction[]              @relation("CaseTransactionDeletedBy")
  createdInsuranceCases                InsuranceArbitrationCase[]     @relation("InsuranceArbitrationCaseCreatedBy")
  updatedInsuranceCases                InsuranceArbitrationCase[]     @relation("InsuranceArbitrationCaseUpdatedBy")
  insuranceDocuments                   InsuranceArbitrationDocument[] @relation("InsuranceDocumentUploadedBy")
  deletedInsuranceDocuments            InsuranceArbitrationDocument[] @relation("InsuranceDocumentDeletedBy")
  insuranceNotes                       InsuranceArbitrationNote[]      @relation("InsuranceNoteAuthor")
  deletedInsuranceNotes                InsuranceArbitrationNote[]      @relation("InsuranceNoteDeletedBy")
  insuranceNotifications               InsuranceArbitrationNotification[] @relation("InsuranceNotificationCreatedBy")
  deletedInsuranceNotifications        InsuranceArbitrationNotification[] @relation("InsuranceNotificationDeletedBy")
  createdGeneralCases                  GeneralLegalCase[]             @relation("GeneralLegalCaseCreatedBy")
  updatedGeneralCases                  GeneralLegalCase[]             @relation("GeneralLegalCaseUpdatedBy")
  archivedGeneralCases                 GeneralLegalCase[]             @relation("GeneralLegalCaseArchivedBy")
  responsibleGeneralCases              GeneralLegalCase[]             @relation("GeneralLegalCaseResponsibleUser")
  staffedGeneralCases                  GeneralLegalCase[]             @relation("GeneralLegalCaseFileStaff")
  representedGeneralParties            GeneralCaseParty[]             @relation("GeneralCasePartyRepresentative")
  createdGeneralCaseFinancialEntries   GeneralCaseFinancialEntry[]    @relation("GeneralCaseFinancialEntryCreatedBy")
  updatedGeneralCaseFinancialEntries   GeneralCaseFinancialEntry[]    @relation("GeneralCaseFinancialEntryUpdatedBy")
  deletedGeneralCaseFinancialEntries   GeneralCaseFinancialEntry[]    @relation("GeneralCaseFinancialEntryDeletedBy")
  responsibleGeneralCaseProcessEntries GeneralCaseProcessEntry[]      @relation("GeneralCaseProcessEntryResponsibleUser")
  createdGeneralCaseProcessEntries     GeneralCaseProcessEntry[]      @relation("GeneralCaseProcessEntryCreatedBy")
  updatedGeneralCaseProcessEntries     GeneralCaseProcessEntry[]      @relation("GeneralCaseProcessEntryUpdatedBy")
  deletedGeneralCaseProcessEntries     GeneralCaseProcessEntry[]      @relation("GeneralCaseProcessEntryDeletedBy")
  attendingGeneralCaseHearings         GeneralCaseHearing[]           @relation("GeneralCaseHearingAttendee")
  createdGeneralCaseHearings           GeneralCaseHearing[]           @relation("GeneralCaseHearingCreatedBy")
  updatedGeneralCaseHearings           GeneralCaseHearing[]           @relation("GeneralCaseHearingUpdatedBy")
  deletedGeneralCaseHearings           GeneralCaseHearing[]           @relation("GeneralCaseHearingDeletedBy")
  uploadedGeneralCaseDocuments         GeneralCaseDocument[]          @relation("GeneralCaseDocumentUploadedBy")
  deletedGeneralCaseDocuments          GeneralCaseDocument[]          @relation("GeneralCaseDocumentDeletedBy")
  assignedGeneralCaseTasks             GeneralCaseTask[]              @relation("GeneralCaseTaskAssignee")
  createdGeneralCaseTasks              GeneralCaseTask[]              @relation("GeneralCaseTaskCreatedBy")
  updatedGeneralCaseTasks              GeneralCaseTask[]              @relation("GeneralCaseTaskUpdatedBy")
  deletedGeneralCaseTasks              GeneralCaseTask[]              @relation("GeneralCaseTaskDeletedBy")
  authoredGeneralCaseNotes             GeneralCaseNote[]              @relation("GeneralCaseNoteAuthor")
  deletedGeneralCaseNotes              GeneralCaseNote[]              @relation("GeneralCaseNoteDeletedBy")
  reminderDeliveries                   ReminderDelivery[]

  @@unique([email])
  @@index([role])
  @@index([banned])
  @@index([deletionDueAt])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model EmailRateLimit {
  key         String @id
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("email_rate_limit")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  event         String
  targetType    String?
  targetId      String?
  context       Json?
  ipAddressHash String?
  createdAt     DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

enum CaseFileStatus {
  OPEN
  ENFORCEMENT
  INSTALLMENT
  PENDING
  CLOSED
}

enum DebtorType {
  INSURANCE_COMPANY
  INDIVIDUAL
  COMPANY
}

enum JudgmentStatus {
  WITHOUT_JUDGMENT
  WITH_JUDGMENT
}

enum CaseTransactionType {
  INCOME
  EXPENSE
}

enum CaseTransactionCategory {
  PRINCIPAL
  PRE_FOLLOW_UP_INTEREST
  POST_FOLLOW_UP_INTEREST
  ATTORNEY_FEE
  EXPENSE
  LITIGATION_EXPENSE
  PRISON_FEE
  COLLECTION_FEE
  OTHER
  EXPENSE_REFUND
  PENALTY_COMPENSATION
  OTHER_INCOME
  FEE
  NOTIFICATION
  EXPERT_FEE
  ATTORNEY_PAYMENT
  OTHER_EXPENSE
}

enum CaseFileChangeType {
  CREATED
  UPDATED
  STATUS_CHANGED
}

enum ReminderStatus {
  PENDING
  SENT
  PARTIALLY_SENT
  FAILED
  CANCELLED
}

model CaseFile {
  id                    String            @id @default(cuid())
  referenceNumber       String            @unique
  licenseHolder         String
  vehiclePlate          String
  accidentDate          DateTime          @db.Date
  debtorType            DebtorType
  debtorName            String?
  debtors               Json              @default("[]")
  damageAmount          Decimal           @default(0) @db.Decimal(18, 2)
  depreciationAmount    Decimal           @default(0) @db.Decimal(18, 2)
  profitLossAmount      Decimal           @default(0) @db.Decimal(18, 2)
  preEnforcementInterestAmount  Decimal   @default(0) @db.Decimal(18, 2)
  postEnforcementInterestAmount Decimal   @default(0) @db.Decimal(18, 2)
  hasDamageClaim        Boolean           @default(false)
  hasDepreciationClaim  Boolean           @default(false)
  hasProfitLossClaim    Boolean           @default(false)
  profitLossDays        Int?
  dailyRentalAmount     Decimal?          @db.Decimal(18, 2)
  judgmentStatus        JudgmentStatus    @default(WITHOUT_JUDGMENT)
  discountAmount        Decimal           @default(0) @db.Decimal(18, 2)
  enforcementOffice     String?
  enforcementFileNumber String?
  vehicleLien           Boolean           @default(false)
  bankLien              Boolean           @default(false)
  titleDeedLien         Boolean           @default(false)
  salaryLien            Boolean           @default(false)
  installmentCount      Int?
  status                CaseFileStatus    @default(OPEN)
  documentFolders       Json              @default("[]")
  version               Int               @default(1)
  createdById           String
  updatedById           String
  archivedById          String?
  archivedAt            DateTime?
  purgeAfter            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  createdBy             User              @relation("CaseFileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User              @relation("CaseFileUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy            User?             @relation("CaseFileArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  changes               CaseFileChange[]
  notes                 CaseNote[]
  documents             CaseDocument[]
  reminders             CaseReminder[]
  transactions          CaseTransaction[]

  @@unique([enforcementOffice, enforcementFileNumber])
  @@index([status])
  @@index([vehiclePlate])
  @@index([accidentDate])
  @@index([debtorName])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([purgeAfter])
  @@map("case_file")
}

model CaseFileChange {
  id              String             @id @default(cuid())
  caseFileId      String
  changedById     String
  changeType      CaseFileChangeType
  previousVersion Int?
  newVersion      Int
  changedFields   Json?
  snapshot        Json
  createdAt       DateTime           @default(now())
  caseFile        CaseFile           @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  changedBy       User               @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([caseFileId, createdAt])
  @@index([changedById, createdAt])
  @@map("case_file_change")
}

model CaseNote {
  id          String    @id @default(cuid())
  caseFileId  String
  authorId    String
  deletedById String?
  content     String    @db.Text
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  caseFile    CaseFile  @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  author      User      @relation("CaseNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy   User?     @relation("CaseNoteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseFileId, createdAt])
  @@index([caseFileId, deletedAt, createdAt])
  @@index([authorId, createdAt])
  @@index([deletedById])
  @@map("case_note")
}

model CaseDocument {
  id            String           @id @default(cuid())
  caseFileId    String
  uploadedById  String
  originalName  String           @db.VarChar(255)
  storageKey    String           @unique
  mimeType      String           @db.VarChar(100)
  sizeBytes     Int
  sha256        String           @db.Char(64)
  transactionId String?
  category      String           @default("OTHER") @db.VarChar(50)
  folderKey     String?          @db.VarChar(100)
  deletedById   String?
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  caseFile      CaseFile         @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  uploadedBy    User             @relation("CaseDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy     User?            @relation("CaseDocumentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  transaction   CaseTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([caseFileId, createdAt])
  @@index([caseFileId, category, createdAt])
  @@index([caseFileId, folderKey, deletedAt, createdAt])
  @@index([uploadedById, createdAt])
  @@index([deletedById])
  @@index([transactionId])
  @@map("case_document")
}

enum InsuranceCaseType {
  DEPRECIATION
  DEPRECIATION_DIFFERENCE
  DAMAGE_DIFFERENCE
  ZERO_DAMAGE
}

enum InsuranceArbitrationStatus {
  INSURANCE_APPLICATION
  SETTLEMENT_REVIEW
  ARBITRATION_APPLICATION
  ARBITRATION
  EXPERT_REVIEW
  PAYMENT_PENDING
  INSURANCE_PAYMENT_RECEIVED
  ENFORCEMENT
  LITIGATION
  COMPLETED
  CLOSED
}

enum InsurancePaymentType {
  OUTGOING_PAYMENT
  INSURANCE_INCOME
  ARBITRATION_INCOME
  ENFORCEMENT_INCOME
}

model InsuranceArbitrationCase {
  id                         String                         @id @default(cuid())
  referenceNumber            String                         @unique
  arbitrationApplicationNo   String?                        @unique
  opposingInsuranceCompany   String
  opposingPolicyNumber       String?
  policyExpiryDate           DateTime?                      @db.Date
  opposingVehicleOwner       String?
  opposingIdentityNumber     String?
  vehicleOwner               String
  identityNumber             String?
  vehiclePlate               String
  accidentDate               DateTime                       @db.Date
  postalDeliveryDate         DateTime?                      @db.Date
  caseTypes                  InsuranceCaseType[]            @map("caseType")
  insuranceApplicationDate   DateTime?                      @db.Date
  insuranceSettlementOffer   Decimal                        @default(0) @db.Decimal(18, 2)
  arbitrationApplicationDate DateTime?                      @db.Date
  hasArbitration             Boolean                        @default(false)
  arbitrationCaseNumber      String?
  status                     InsuranceArbitrationStatus     @default(INSURANCE_APPLICATION)
  postageExpense             Decimal                        @default(0) @db.Decimal(18, 2)
  enforcementExpense         Decimal                        @default(0) @db.Decimal(18, 2)
  arbitrationApplicationFee  Decimal                        @default(0) @db.Decimal(18, 2)
  expertFee                  Decimal                        @default(0) @db.Decimal(18, 2)
  postalAmount               Decimal                        @default(0) @db.Decimal(18, 2)
  actualDepreciationAmount   Decimal                        @default(0) @db.Decimal(18, 2)
  description                String?
  documentFolders            Json                           @default("[]")
  version                    Int                            @default(1)
  createdById                String
  updatedById                String
  archivedById               String?
  archivedAt                 DateTime?
  purgeAfter                 DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  createdBy                  User                           @relation("InsuranceArbitrationCaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                  User                           @relation("InsuranceArbitrationCaseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy                 User?                          @relation("InsuranceArbitrationCaseArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  documents                  InsuranceArbitrationDocument[]
  notes                      InsuranceArbitrationNote[]
  payments                   InsuranceArbitrationPayment[]
  notifications              InsuranceArbitrationNotification[]

  @@index([vehiclePlate])
  @@index([opposingInsuranceCompany])
  @@index([accidentDate])
  @@index([status])
  @@index([updatedAt])
  @@index([archivedAt])
  @@index([purgeAfter])
  @@map("insurance_arbitration_case")
}

model InsuranceArbitrationPayment {
  id           String                   @id @default(cuid())
  caseId       String
  type         InsurancePaymentType
  paymentDate  DateTime                 @db.Date
  amount       Decimal                  @db.Decimal(18, 2)
  commission   Decimal                  @default(0) @db.Decimal(18, 2)
  clientAmount Decimal                  @default(0) @db.Decimal(18, 2)
  description  String?                  @db.VarChar(500)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  case         InsuranceArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, paymentDate, createdAt])
  @@map("insurance_arbitration_payment")
}

model InsuranceArbitrationDocument {
  id           String                   @id @default(cuid())
  caseId       String
  uploadedById String
  originalName String                   @db.VarChar(255)
  storageKey   String                   @unique
  mimeType     String                   @db.VarChar(100)
  sizeBytes    Int
  sha256       String                   @db.Char(64)
  category     String                   @default("OTHER") @db.VarChar(50)
  folderKey    String?                  @db.VarChar(100)
  deletedById  String?
  deletedAt    DateTime?
  createdAt    DateTime                 @default(now())
  case         InsuranceArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy   User                     @relation("InsuranceDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy    User?                    @relation("InsuranceDocumentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([caseId, folderKey, deletedAt, createdAt])
  @@index([uploadedById, createdAt])
  @@index([deletedById])
  @@map("insurance_arbitration_document")
}

model InsuranceArbitrationNote {
  id          String                   @id @default(cuid())
  caseId      String
  authorId    String
  deletedById String?
  content     String                   @db.Text
  deletedAt   DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  case        InsuranceArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author      User                     @relation("InsuranceNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy   User?                    @relation("InsuranceNoteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([caseId, deletedAt, createdAt])
  @@index([authorId, createdAt])
  @@index([deletedById])
  @@map("insurance_arbitration_note")
}

model InsuranceArbitrationNotification {
  id          String                   @id @default(cuid())
  caseId      String
  createdById String
  deletedById String?
  title       String                   @db.VarChar(150)
  description String?                  @db.Text
  reminderType String?                 @db.VarChar(100)
  priority    String                   @default("MEDIUM") @db.VarChar(10)
  eventAt     DateTime
  notifyAt    DateTime
  status      ReminderStatus           @default(PENDING)
  sentAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  case        InsuranceArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("InsuranceNotificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy   User?                    @relation("InsuranceNotificationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, deletedAt, eventAt])
  @@index([status, notifyAt])
  @@index([createdById, createdAt])
  @@map("insurance_arbitration_notification")
}

enum GeneralCaseKind {
  GENERAL_LITIGATION
  MEDIATION
}

enum GeneralCaseStatus {
  DRAFT
  ACTIVE
  DECISION
  APPEAL
  COMPLETED
  CLOSED
}

enum GeneralCaseStage {
  CASE_OPENING
  NOTIFICATION
  RESPONSE_PETITION
  PRELIMINARY_REVIEW
  EXAMINATION
  EXPERT_REPORT
  HEARING
  DECISION
  APPEAL
  CASSATION
  FINALIZATION
  COLLECTION
  CLOSED
}

enum GeneralCaseConfidentiality {
  NORMAL
  RESTRICTED
}

enum GeneralPartyKind {
  INDIVIDUAL
  ORGANIZATION
}

enum GeneralPartyRole {
  PLAINTIFF
  DEFENDANT
  APPLICANT
  RESPONDENT
  INTERVENOR
  THIRD_PARTY
  RELATED_INSTITUTION
}

enum GeneralFinancialEntryType {
  EXPENSE
  COLLECTION
  PAYMENT
}

enum GeneralCollectionStatus {
  NOT_COLLECTED
  PARTIAL
  COLLECTED
}

enum GeneralPaymentPlan {
  CASH
  INSTALLMENT
}

enum GeneralProcessEntryType {
  STAGE_CHANGE
  FILING
  NOTIFICATION
  HEARING
  DECISION
  OTHER
}

enum GeneralHearingStatus {
  PLANNED
  COMPLETED
  POSTPONED
  CANCELLED
}

enum GeneralTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum GeneralTaskStatus {
  PLANNED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GeneralNoteVisibility {
  TEAM
  PRIVATE
}

model GeneralLegalCase {
  id                       String                      @id @default(cuid())
  referenceNumber          String                      @unique
  kind                     GeneralCaseKind             @default(GENERAL_LITIGATION)
  caseType                 String                      @db.VarChar(100)
  subject                  String                      @db.Text
  openingDate              DateTime                    @db.Date
  caseValue                Decimal                     @default(0) @db.Decimal(18, 2)
  claimAmount              Decimal                     @default(0) @db.Decimal(18, 2)
  amendmentAmount          Decimal                     @default(0) @db.Decimal(18, 2)
  interestRequested        Boolean                     @default(false)
  interestStartDate        DateTime?                   @db.Date
  expectedCollectionAmount Decimal                     @default(0) @db.Decimal(18, 2)
  opposingAttorneyFee      Decimal                     @default(0) @db.Decimal(18, 2)
  collectionStatus         GeneralCollectionStatus     @default(NOT_COLLECTED)
  paymentPlan              GeneralPaymentPlan          @default(CASH)
  installmentCount         Int?
  financeDescription       String?                     @db.Text
  uyapMainNumber           String?                     @db.VarChar(80)
  uyapDecisionNumber       String?                     @db.VarChar(80)
  courthouse               String?                     @db.VarChar(150)
  courtType                String?                     @db.VarChar(100)
  court                    String?                     @db.VarChar(150)
  status                   GeneralCaseStatus           @default(ACTIVE)
  stage                    GeneralCaseStage            @default(CASE_OPENING)
  procedure                String?                     @db.VarChar(100)
  urgent                   Boolean                     @default(false)
  confidentiality          GeneralCaseConfidentiality  @default(NORMAL)
  estimatedCompletionDate  DateTime?                   @db.Date
  trackingGroup            String?                     @db.VarChar(100)
  tags                     String[]                    @default([])
  office                   String?                     @db.VarChar(100)
  description              String?                     @db.Text
  documentFolders          Json                        @default("[]")
  responsibleUserId        String
  fileStaffUserId          String?
  version                  Int                         @default(1)
  createdById              String
  updatedById              String
  archivedById             String?
  archivedAt               DateTime?
  purgeAfter               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  responsibleUser          User                        @relation("GeneralLegalCaseResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  fileStaffUser            User?                       @relation("GeneralLegalCaseFileStaff", fields: [fileStaffUserId], references: [id], onDelete: SetNull)
  createdBy                User                        @relation("GeneralLegalCaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                User                        @relation("GeneralLegalCaseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy               User?                       @relation("GeneralLegalCaseArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  parties                  GeneralCaseParty[]
  financialEntries         GeneralCaseFinancialEntry[]
  processEntries           GeneralCaseProcessEntry[]
  hearings                 GeneralCaseHearing[]
  documents                GeneralCaseDocument[]
  tasks                    GeneralCaseTask[]
  notes                    GeneralCaseNote[]

  @@index([kind, status])
  @@index([stage])
  @@index([caseType])
  @@index([court])
  @@index([openingDate])
  @@index([responsibleUserId, status])
  @@index([updatedAt])
  @@index([archivedAt])
  @@index([purgeAfter])
  @@map("general_legal_case")
}

model GeneralCaseParty {
  id                   String           @id @default(cuid())
  caseId               String
  role                 GeneralPartyRole
  kind                 GeneralPartyKind
  name                 String           @db.VarChar(200)
  identityOrTaxNumber  String?          @db.VarChar(20)
  phone                String?          @db.VarChar(30)
  email                String?          @db.VarChar(254)
  address              String?          @db.Text
  representativeUserId String?
  representativeName   String?          @db.VarChar(200)
  clientType           String?          @db.VarChar(100)
  description          String?          @db.VarChar(500)
  sortOrder            Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  case                 GeneralLegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  representativeUser   User?            @relation("GeneralCasePartyRepresentative", fields: [representativeUserId], references: [id], onDelete: SetNull)

  @@index([caseId, role, sortOrder])
  @@index([identityOrTaxNumber])
  @@index([name])
  @@index([representativeUserId])
  @@map("general_case_party")
}

model GeneralCaseFinancialEntry {
  id          String                    @id @default(cuid())
  caseId      String
  type        GeneralFinancialEntryType
  category    String                    @db.VarChar(100)
  entryDate   DateTime                  @db.Date
  amount      Decimal                   @db.Decimal(18, 2)
  description String                    @db.VarChar(500)
  createdById String
  updatedById String
  deletedById String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  deletedAt   DateTime?
  version     Int                       @default(1)
  case        GeneralLegalCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User                      @relation("GeneralCaseFinancialEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User                      @relation("GeneralCaseFinancialEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?                     @relation("GeneralCaseFinancialEntryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, entryDate, createdAt])
  @@index([caseId, deletedAt])
  @@index([createdById, createdAt])
  @@map("general_case_financial_entry")
}

model GeneralCaseProcessEntry {
  id                String                  @id @default(cuid())
  caseId            String
  type              GeneralProcessEntryType
  stage             GeneralCaseStage
  eventDate         DateTime                @db.Date
  action            String                  @db.VarChar(150)
  description       String?                 @db.Text
  responsibleUserId String?
  createdById       String
  updatedById       String
  deletedById       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  version           Int                     @default(1)
  case              GeneralLegalCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  responsibleUser   User?                   @relation("GeneralCaseProcessEntryResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdBy         User                    @relation("GeneralCaseProcessEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User                    @relation("GeneralCaseProcessEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy         User?                   @relation("GeneralCaseProcessEntryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, eventDate, createdAt])
  @@index([caseId, stage, deletedAt])
  @@index([responsibleUserId])
  @@map("general_case_process_entry")
}

model GeneralCaseHearing {
  id                    String               @id @default(cuid())
  caseId                String
  startsAt              DateTime
  court                 String               @db.VarChar(150)
  hearingType           String               @db.VarChar(100)
  courtroom             String?              @db.VarChar(100)
  attendeeUserId        String?
  reminderOffsetMinutes Int?
  note                  String?              @db.Text
  status                GeneralHearingStatus @default(PLANNED)
  createdById           String
  updatedById           String
  deletedById           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  version               Int                  @default(1)
  case                  GeneralLegalCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attendeeUser          User?                @relation("GeneralCaseHearingAttendee", fields: [attendeeUserId], references: [id], onDelete: SetNull)
  createdBy             User                 @relation("GeneralCaseHearingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                 @relation("GeneralCaseHearingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy             User?                @relation("GeneralCaseHearingDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, startsAt])
  @@index([caseId, status, deletedAt])
  @@index([attendeeUserId])
  @@map("general_case_hearing")
}

model GeneralCaseDocument {
  id           String           @id @default(cuid())
  caseId       String
  uploadedById String
  deletedById  String?
  originalName String           @db.VarChar(255)
  category     String           @db.VarChar(100)
  folderKey    String?          @db.VarChar(80)
  storageKey   String           @unique
  mimeType     String           @db.VarChar(100)
  sizeBytes    Int
  sha256       String           @db.Char(64)
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  case         GeneralLegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation("GeneralCaseDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy    User?            @relation("GeneralCaseDocumentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, category, createdAt])
  @@index([caseId, folderKey])
  @@index([uploadedById, createdAt])
  @@index([caseId, deletedAt])
  @@map("general_case_document")
}

model GeneralCaseTask {
  id                    String              @id @default(cuid())
  caseId                String
  title                 String              @db.VarChar(150)
  description           String?             @db.Text
  assigneeUserId        String?
  priority              GeneralTaskPriority @default(MEDIUM)
  dueAt                 DateTime
  taskType              String?             @db.VarChar(100)
  reminderOffsetMinutes Int?
  status                GeneralTaskStatus   @default(PLANNED)
  createdById           String
  updatedById           String
  deletedById           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  version               Int                 @default(1)
  case                  GeneralLegalCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee              User?               @relation("GeneralCaseTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy             User                @relation("GeneralCaseTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                @relation("GeneralCaseTaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy             User?               @relation("GeneralCaseTaskDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, dueAt])
  @@index([caseId, status, priority])
  @@index([assigneeUserId, status, dueAt])
  @@index([caseId, deletedAt])
  @@map("general_case_task")
}

model GeneralCaseNote {
  id         String                @id @default(cuid())
  caseId     String
  authorId   String
  content    String                @db.Text
  noteType   String                @db.VarChar(50)
  visibility GeneralNoteVisibility @default(TEAM)
  important  Boolean               @default(false)
  deletedById String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  deletedAt  DateTime?
  case       GeneralLegalCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author     User                  @relation("GeneralCaseNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy  User?                 @relation("GeneralCaseNoteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([caseId, noteType, important])
  @@index([authorId, createdAt])
  @@index([caseId, deletedAt])
  @@map("general_case_note")
}

model CaseTransaction {
  id              String                  @id @default(cuid())
  caseFileId      String
  type            CaseTransactionType
  category        CaseTransactionCategory
  transactionDate DateTime                @db.Date
  amount          Decimal                 @db.Decimal(18, 2)
  description     String                  @db.VarChar(500)
  createdById     String
  deletedById     String?
  createdAt       DateTime                @default(now())
  deletedAt       DateTime?
  caseFile        CaseFile                @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("CaseTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy       User?                   @relation("CaseTransactionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  documents       CaseDocument[]

  @@index([caseFileId, transactionDate, createdAt])
  @@index([caseFileId, deletedAt])
  @@index([createdById, createdAt])
  @@map("case_transaction")
}

model CaseReminder {
  id                 String             @id @default(cuid())
  caseFileId         String
  createdById        String
  title              String
  description        String?            @db.Text
  reminderType       String?            @db.VarChar(100)
  priority           String             @default("MEDIUM") @db.VarChar(10)
  eventAt            DateTime           @default(now())
  dueAt              DateTime
  sendEmail          Boolean            @default(true)
  sendSms            Boolean            @default(false)
  status             ReminderStatus     @default(PENDING)
  sentAt             DateTime?
  deliveryPreparedAt DateTime?
  nextPreparationAt  DateTime           @default(now())
  deliveries         ReminderDelivery[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  caseFile           CaseFile           @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  createdBy          User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, dueAt])
  @@index([caseFileId, dueAt])
  @@index([createdById, createdAt])
  @@index([deliveryPreparedAt, nextPreparationAt])
  @@map("case_reminder")
}

enum ReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  UNCERTAIN
  CANCELLED
}

model ReminderDelivery {
  id             String                 @id @default(cuid())
  reminderId     String
  recipientId    String
  recipientEmail String
  status         ReminderDeliveryStatus @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  startedAt      DateTime?
  sentAt         DateTime?
  failureCode    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  reminder       CaseReminder           @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  recipient      User                   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([reminderId, recipientId])
  @@index([status, nextAttemptAt])
  @@index([status, startedAt])
  @@map("reminder_delivery")
}
